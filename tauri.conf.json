{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Skill Cookbook Relay",
  "version": "0.1.0",
  "identifier": "com.supervaize.skill-cookbook-relay",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "https://skills.runwaize.com",
    "beforeBuildCommand": "",
    "frontendDist": "ui"
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    }
  },
  "app": {
    "security": {
      "csp": "default-src 'self' https://skills.runwaize.com http://127.0.0.1:9123; script-src 'self' 'unsafe-inline' https://skills.runwaize.com; style-src 'self' 'unsafe-inline' https://skills.runwaize.com; connect-src 'self' https://skills.runwaize.com http://127.0.0.1:9123",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**"
        ]
      }
    },
    "windows": [],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": true,
      "tooltip": "Skill Cookbook Relay"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "active": false,
      "endpoints": [],
      "pubkey": ""
    }
  }
}